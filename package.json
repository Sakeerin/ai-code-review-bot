{
  "name": "ai-review-bot",
  "description": "Open-source AI code reviews for GitHub, GitLab, and Bitbucket",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sakeerin/ai-code-review-bot.git"
  },
  "homepage": "https://github.com/Sakeerin/ai-code-review-bot#readme",
  "bugs": {
    "url": "https://github.com/Sakeerin/ai-code-review-bot/issues"
  },
  "private": true,
  "overrides": {
    "postcss": "^8.5.18",
    "rollup": "^3.30.0",
    "undici": "^6.29.1",
    "@fastify/busboy": "^3.2.1",
    "@azure/msal-node": "^7.1.0",
    "ws": "^8.21.0",
    "zod": "^4.6.6"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "audit:security": "bun run scripts/audit-security.ts",
    "test": "bun test tests",
    "test:postgres": "bun test integration/postgres.test.ts",
    "billing:verify": "bun run apps/dashboard/scripts/verify-stripe-billing.ts",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:generate": "bun run --filter @repo/db generate",
    "db:migrate": "bun run --filter @repo/db migrate",
    "db:push": "bun run --filter @repo/db push",
    "db:studio": "bun run --filter @repo/db studio",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^15.5.28",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "typescript-eslint": "^8.72.1",
    "@electric-sql/pglite": "^0.5.12",
    "@types/bun": "^1.4.4",
    "drizzle-orm": "^0.45.4",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "bun@1.4.4"
}

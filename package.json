{
  "name": "ai-review-bot",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "test": "bun test tests",
    "billing:verify": "bun run apps/dashboard/scripts/verify-stripe-billing.ts",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:generate": "bun run --filter @repo/db generate",
    "db:migrate": "bun run --filter @repo/db migrate",
    "db:push": "bun run --filter @repo/db push",
    "db:studio": "bun run --filter @repo/db studio",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@next/eslint-plugin-next": "^15.5.14",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "typescript-eslint": "^8.46.0",
    "@electric-sql/pglite": "^0.5.12",
    "@types/bun": "^1.3.0",
    "drizzle-orm": "^0.40.0",
    "prettier": "^3.5.0",
    "turbo": "^2.4.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "bun@1.3.0"
}

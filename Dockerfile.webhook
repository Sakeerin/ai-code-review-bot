FROM oven/bun:1.4.4-alpine AS deps
WORKDIR /app
COPY package.json bun.lock ./
COPY apps/dashboard/package.json ./apps/dashboard/
COPY apps/docs/package.json ./apps/docs/
COPY apps/mcp-server/package.json ./apps/mcp-server/
COPY apps/vscode-extension/package.json ./apps/vscode-extension/
COPY apps/webhook/package.json ./apps/webhook/
COPY packages/ai/package.json ./packages/ai/
COPY packages/bitbucket/package.json ./packages/bitbucket/
COPY packages/db/package.json ./packages/db/
COPY packages/github/package.json ./packages/github/
COPY packages/gitlab/package.json ./packages/gitlab/
COPY packages/queue/package.json ./packages/queue/
RUN bun install --frozen-lockfile

FROM deps AS runtime
COPY . .
ENV NODE_ENV=production
ENV PORT=3000
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s CMD wget -qO- http://127.0.0.1:3000/health || exit 1
CMD ["bun", "run", "apps/webhook/src/server.ts"]

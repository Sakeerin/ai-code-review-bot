FROM oven/bun:1.3.0-alpine AS base

# ── Install deps ──────────────────────────────────────────────────
FROM base AS deps
WORKDIR /app
COPY package.json bun.lock* ./
COPY apps/webhook/package.json ./apps/webhook/
COPY packages/ai/package.json ./packages/ai/
COPY packages/db/package.json ./packages/db/
COPY packages/github/package.json ./packages/github/
COPY packages/gitlab/package.json ./packages/gitlab/
COPY packages/bitbucket/package.json ./packages/bitbucket/
COPY packages/queue/package.json ./packages/queue/
RUN bun install --frozen-lockfile

# ── Build ─────────────────────────────────────────────────────────
FROM base AS build
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN bun run build --filter=@repo/webhook 2>/dev/null || true

# ── Runtime ───────────────────────────────────────────────────────
FROM base AS runtime
WORKDIR /app
ENV NODE_ENV=production

COPY --from=deps /app/node_modules ./node_modules
COPY --from=build /app/apps/webhook ./apps/webhook
COPY --from=build /app/packages ./packages

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s \
  CMD wget -qO- http://localhost:3000/health || exit 1

CMD ["bun", "run", "apps/webhook/src/server.ts"]
